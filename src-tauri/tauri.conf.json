{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TRELLIS Studio",
  "identifier": "com.soundtrackgeek.trellisstudio",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "TRELLIS.2 Studio", "width": 1320, "height": 840, "minWidth": 1000, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "soundtrackgeek",
    "shortDescription": "Image to 3D game assets with TRELLIS.2",
    "resources": { "../target/release/t2.exe": "t2.exe" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "startMenuFolder": "TRELLIS Studio",
        "displayLanguageSelector": false
      }
    }
  }
}
